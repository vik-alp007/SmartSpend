# ========================================================
# SmartSpend Frontend Environment Configuration Template
# Place this in client/.env or configure in Vercel Frontend Project
# ========================================================

# Public Backend API Base URL
# Leave empty or omit if deploying frontend and backend in a Single Vercel Project (defaults to relative /api)
# Set to your deployed backend URL if deploying as a Separate Vercel Project
# Example: https://smartspend-backend.vercel.app/api
VITE_API_BASE_URL=
