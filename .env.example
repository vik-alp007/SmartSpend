# ========================================================
# SmartSpend Server Environment Configuration Template
# Copy this file to server/.env and fill in the values.
# ========================================================

# Server Port
PORT=8080

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Local example: mongodb://localhost:27017/smartspend
# Atlas example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/smartspend?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/smartspend

# JWT Secret Key (Use a strong random string in production)
JWT_SECRET=smartspend_super_secret_jwt_key_2026_dev_only

# JWT Expiration (e.g. '7d', '24h')
JWT_EXPIRES_IN=7d

# Frontend Client Origin (for CORS and cookie matching)
CLIENT_ORIGIN=http://localhost:5173

# Cookie Secret
COOKIE_SECRET=smartspend_cookie_secret_dev_32chars_min

# Competition Challenge Mode
# Set to 'true' for competition mode (with intentional bugs enabled)
# Set to 'false' for corrected/production mode (all bugs disabled)
BUG_CHALLENGE_MODE=true
