# ========================================================
# SmartSpend Root Environment Configuration Template
# For local fullstack development or Vercel Single Project
# ========================================================

# Server Port (Local default: 8080)
PORT=8080

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection String
# Local: mongodb://localhost:27017/smartspend
# Production (MongoDB Atlas): mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/smartspend?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/smartspend

# JWT Secret Key (Required in production — use a strong 32+ character random string)
JWT_SECRET=your_production_jwt_secret_key_change_me_min_32_chars

# JWT Expiration (e.g. '7d', '24h')
JWT_EXPIRES_IN=7d

# Allowed Frontend Client Origin(s) for CORS (comma-separated if multiple)
# Local: http://localhost:5173
# Production (if separate frontend): https://your-frontend-project.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Cookie Signing Secret
COOKIE_SECRET=your_cookie_signing_secret_min_32_chars

# Competition Challenge Mode
# 'true'  = Competition mode (with intentional test defects enabled)
# 'false' = Production / corrected mode
BUG_CHALLENGE_MODE=true

# Frontend API Base URL (Safe for client exposure)
# Leave blank or omit for Single Project Vercel deployment (defaults to /api)
# Set to 'https://your-backend.vercel.app/api' ONLY if deploying frontend separately
VITE_API_BASE_URL=
